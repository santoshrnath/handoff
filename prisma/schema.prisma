// ─────────────────────────────────────────────────────────────────────────────
// ContextBridge — Prisma schema
// ─────────────────────────────────────────────────────────────────────────────
// Domain: Context (the thing being handed off), with nested Stakeholders,
// Decisions, OpenLoops, WatchOuts, HonestNotes. Handoff binds a Context to
// a transfer event (from -> to). Interview captures the AI interrogation.
//
// Every row is tenant-scoped via `tenantId` (Clerk user id, or "default").
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContextType {
  PROJECT
  CLIENT
  WORKSTREAM
  PROCESS
  STAKEHOLDER
  ACCOUNT
}

enum ContextStatus {
  DRAFT
  ACTIVE
  STANDING
  ARCHIVED
}

enum Importance {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum HandoffType {
  LEAVE
  ROTATION
  DELEGATION
  ATTRITION
  STAND_IN
  ONBOARDING
}

enum HandoffStatus {
  DRAFT
  READY
  TRANSFERRED
  ACKNOWLEDGED
}

enum SensitivityLevel {
  PUBLIC
  TEAM
  PRIVATE
  POLITICAL
}

enum InterviewStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum InterviewPhase {
  WARM_UP
  CORE
  DEEP_DIVE
  WRAP_UP
}

enum MessageRole {
  ASSISTANT
  USER
  SYSTEM
}

enum RelationshipKind {
  CHAMPION
  ALLY
  NEUTRAL
  SKEPTIC
  BLOCKER
  INFLUENCER
  DECISION_MAKER
  UNKNOWN
}

enum OpenLoopState {
  IN_FLIGHT
  STUCK
  DEFERRED
  BLOCKED
}

enum WatchOutSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RealityCheckStatus {
  CONFIRMED
  UNCLEAR
  OUTDATED
}

enum RealityCheckItemKind {
  STAKEHOLDER
  DECISION
  OPEN_LOOP
  WATCH_OUT
  PROCESS
  SNAPSHOT
}

enum NudgeKind {
  STANDING_REFRESH
  DRIFT
  FOLLOW_UP
}

enum NudgeStatus {
  PENDING
  DISMISSED
  ACTED
}

enum UsageKind {
  INTERVIEW_TURN
  SYNTHESIZE
  RECEIVER_QA
  REDACTION_CHECK
  ARTIFACT_EXTRACT
}

// ─── Core domain ─────────────────────────────────────────────────────────────

model Context {
  id              String         @id @default(cuid())
  tenantId        String         @default("default")
  ownerUserId     String
  ownerEmail      String?

  title           String
  type            ContextType    @default(PROJECT)
  status          ContextStatus  @default(DRAFT)
  importance      Importance     @default(MEDIUM)
  sensitivity     SensitivityLevel @default(TEAM)

  // Snapshot
  description     String?        @db.Text
  currentPhase    String?
  orgPosition     String?

  // Process narrative
  processFlow     String?        @db.Text
  cadences        Json?
  tools           Json?
  workarounds     String?        @db.Text

  completeness    Int            @default(0) // 0..100

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  stakeholders    Stakeholder[]
  decisions       Decision[]
  openLoops       OpenLoop[]
  watchOuts       WatchOut[]
  honestNotes     HonestNote[]
  artifacts       Artifact[]
  handoffs        Handoff[]
  interviews      InterviewSession[]
  driftEvents     DriftEvent[]

  @@index([tenantId])
  @@index([ownerUserId])
  @@index([status])
}

model Stakeholder {
  id                  String           @id @default(cuid())
  tenantId            String           @default("default")
  contextId           String

  name                String
  role                String?
  email               String?
  relationship        RelationshipKind @default(UNKNOWN)
  operatingStyle      String?          @db.Text
  whatTheyCareAbout   String?          @db.Text
  howToWorkWithThem   String?          @db.Text
  watchOuts           String?          @db.Text
  interactionSummary  String?          @db.Text

  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  context             Context          @relation(fields: [contextId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([contextId])
}

model Decision {
  id                   String   @id @default(cuid())
  tenantId             String   @default("default")
  contextId            String

  title                String
  rationale            String?  @db.Text
  alternativesRejected String?  @db.Text
  whoWouldPushBack     String?  @db.Text
  decidedOn            DateTime?
  source               String?

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  context              Context  @relation(fields: [contextId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([contextId])
}

model OpenLoop {
  id          String         @id @default(cuid())
  tenantId    String         @default("default")
  contextId   String

  title       String
  detail      String?        @db.Text
  owner       String?
  blocker     String?        @db.Text
  state       OpenLoopState  @default(IN_FLIGHT)
  targetDate  DateTime?

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  context     Context        @relation(fields: [contextId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([contextId])
}

model WatchOut {
  id         String           @id @default(cuid())
  tenantId   String           @default("default")
  contextId  String

  topic      String
  detail     String?          @db.Text
  severity   WatchOutSeverity @default(MEDIUM)
  triedBefore String?         @db.Text

  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  context    Context          @relation(fields: [contextId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([contextId])
}

// Politically-sensitive notes. Stay private to owner until an explicit
// transfer; per-receiver redaction is applied at transfer time.
model HonestNote {
  id              String           @id @default(cuid())
  tenantId        String           @default("default")
  contextId       String

  topic           String
  content         String           @db.Text
  sensitivity     SensitivityLevel @default(POLITICAL)
  transferRules   Json?            // { receivers: ["user_xxx"], redactedFor: ["user_yyy"] }

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  context         Context          @relation(fields: [contextId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([contextId])
}

model Artifact {
  id            String   @id @default(cuid())
  tenantId      String   @default("default")
  contextId     String

  originalName  String
  mimeType      String
  sizeBytes     Int
  storageKey    String
  textStorageKey String?
  summary       String?  @db.Text
  extractedJson Json?
  uploadedBy    String?
  uploadedAt    DateTime @default(now())

  context       Context  @relation(fields: [contextId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([contextId])
}

// ─── Interview (the AI interrogator) ─────────────────────────────────────────

model InterviewSession {
  id           String          @id @default(cuid())
  tenantId     String          @default("default")
  contextId    String
  startedByUserId String

  phase        InterviewPhase  @default(WARM_UP)
  status       InterviewStatus @default(IN_PROGRESS)
  mode         String          @default("full") // "full" | "stand_in"
  durationSeconds Int          @default(0)

  startedAt    DateTime        @default(now())
  completedAt  DateTime?

  messages     InterviewMessage[]
  context      Context         @relation(fields: [contextId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([contextId])
}

model InterviewMessage {
  id            String       @id @default(cuid())
  tenantId      String       @default("default")
  sessionId     String

  role          MessageRole
  content       String       @db.Text
  phase         InterviewPhase @default(WARM_UP)
  meta          Json?

  createdAt     DateTime     @default(now())

  session       InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([tenantId])
}

// ─── Handoff (the transfer event) ────────────────────────────────────────────

model Handoff {
  id              String        @id @default(cuid())
  tenantId        String        @default("default")
  contextId       String

  fromUserId      String
  fromEmail       String?

  type            HandoffType   @default(ROTATION)
  packageNote     String?       @db.Text

  // Legacy single-receiver fields. Kept nullable for back-compat with
  // pre-multi-receiver rows. New handoffs leave these null and use the
  // receivers[] relation. Status is derived (= worst of receivers' states).
  toUserId        String?
  toEmail         String?
  shareToken      String?       @unique @default(cuid())
  status          HandoffStatus @default(DRAFT)
  includedHonestNoteIds Json?
  redactionLog    Json?
  transferredAt   DateTime?
  acknowledgedAt  DateTime?

  createdAt       DateTime      @default(now())

  context         Context           @relation(fields: [contextId], references: [id], onDelete: Cascade)
  receivers       HandoffReceiver[]
  receiverFeedback ReceiverFeedback[]
  qa              QaInteraction[]
  realityChecks   RealityCheck[]

  @@index([tenantId])
  @@index([contextId])
  @@index([fromUserId])
  @@index([toUserId])
}

// Per-receiver row on a handoff. Each receiver has their own redaction
// (which honest notes they see), their own status, their own share token,
// and their own Q&A / feedback / reality-check stream.
model HandoffReceiver {
  id              String        @id @default(cuid())
  tenantId        String        @default("default")
  handoffId       String

  toUserId        String?       // null until they sign in and claim
  toEmail         String?
  toName          String?       // optional display label

  shareToken      String        @unique @default(cuid())
  status          HandoffStatus @default(DRAFT)
  includedHonestNoteIds Json?
  audienceLabel   String?       // free-text e.g. "peer manager", "junior PM"

  createdAt       DateTime      @default(now())
  transferredAt   DateTime?
  acknowledgedAt  DateTime?

  handoff         Handoff           @relation(fields: [handoffId], references: [id], onDelete: Cascade)
  qa              QaInteraction[]
  feedback        ReceiverFeedback[]
  realityChecks   RealityCheck[]

  @@index([handoffId])
  @@index([tenantId])
  @@index([toUserId])
  @@index([toEmail])
}

// 30 / 60 / 90 "I wish I'd known" feedback from the receiver.
model ReceiverFeedback {
  id           String   @id @default(cuid())
  tenantId     String   @default("default")
  handoffId    String
  receiverId   String?

  daysIn       Int
  content      String   @db.Text
  valueRating  Int?     // 1..5
  gapFlag      Boolean  @default(false)

  createdAt    DateTime @default(now())

  handoff      Handoff          @relation(fields: [handoffId], references: [id], onDelete: Cascade)
  receiver     HandoffReceiver? @relation(fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([handoffId])
  @@index([receiverId])
  @@index([tenantId])
}

// Receiver-side Q&A history (the "ask the handoff" feature).
model QaInteraction {
  id           String   @id @default(cuid())
  tenantId     String   @default("default")
  handoffId    String
  receiverId   String?
  askedByUserId String

  question     String   @db.Text
  answer       String   @db.Text
  citations    Json?    // [{ source: "decision" | "stakeholder" | "artifact", id, snippet }]

  createdAt    DateTime @default(now())

  handoff      Handoff          @relation(fields: [handoffId], references: [id], onDelete: Cascade)
  receiver     HandoffReceiver? @relation(fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([handoffId])
  @@index([receiverId])
  @@index([tenantId])
}

// Receiver-side mark of each handoff item against ground truth.
model RealityCheck {
  id           String              @id @default(cuid())
  tenantId     String              @default("default")
  handoffId    String
  receiverId   String?
  itemKind     RealityCheckItemKind
  itemId       String
  status       RealityCheckStatus
  note         String?             @db.Text
  markedBy     String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  handoff      Handoff             @relation(fields: [handoffId], references: [id], onDelete: Cascade)
  receiver     HandoffReceiver?    @relation(fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([handoffId, itemKind, itemId, receiverId])
  @@index([handoffId])
  @@index([receiverId])
  @@index([tenantId])
}

// Dashboard nudges. "Anything to update on this relationship?" for standing,
// or follow-up prompts after a handoff transfer.
model Nudge {
  id           String      @id @default(cuid())
  tenantId     String      @default("default")
  forUserId    String
  kind         NudgeKind
  status       NudgeStatus @default(PENDING)

  contextId    String?
  handoffId    String?
  stakeholderId String?

  title        String
  prompt       String      @db.Text
  cta          String?

  createdAt    DateTime    @default(now())
  resolvedAt   DateTime?

  @@index([forUserId, status])
  @@index([tenantId])
}

// Per-user / per-day / per-kind AI usage counter. Cheap circuit-breaker
// against runaway costs in a POC. Counters reset each UTC day.
model UsageCounter {
  id          String    @id @default(cuid())
  tenantId    String    @default("default")
  userId      String
  dayUtc      String    // YYYY-MM-DD
  kind        UsageKind

  count       Int       @default(0)
  inputTokens Int       @default(0)
  outputTokens Int      @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, dayUtc, kind])
  @@index([tenantId, dayUtc])
}

// Drift detection — flag when reality diverges from documented context.
model DriftEvent {
  id           String   @id @default(cuid())
  tenantId     String   @default("default")
  contextId    String

  topic        String
  observation  String   @db.Text
  proposedUpdate String? @db.Text
  resolved     Boolean  @default(false)

  createdAt    DateTime @default(now())

  context      Context  @relation(fields: [contextId], references: [id], onDelete: Cascade)

  @@index([contextId])
  @@index([tenantId])
}
