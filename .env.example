# Copy to .env.local and fill in. Never commit the real .env.local.

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
SUPER_ADMIN_EMAILS=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

DATABASE_URL=postgresql://contexthandoff:contexthandoff@localhost:5432/contexthandoff?schema=public

STORAGE_PROVIDER=local
S3_ENDPOINT=
