# Copy to .env.local and fill in. Never commit the real .env.local.

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
SUPER_ADMIN_EMAILS=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

DATABASE_URL=postgresql://contexthandoff:contexthandoff@localhost:5432/contexthandoff?schema=public

STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_REGION=fsn1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_ORIGINALS=ch-originals
S3_BUCKET_EXTRACTS=ch-extracts
S3_FORCE_PATH_STYLE=true

MAX_UPLOAD_SIZE_MB=25

# Per-user daily caps on AI-spending endpoints. Defaults are conservative;
# raise for trusted users or your own dogfooding. Resets at 00:00 UTC.
USAGE_CAP_INTERVIEW_TURNS_PER_DAY=80
USAGE_CAP_SYNTHESIZE_PER_DAY=10
USAGE_CAP_QA_PER_DAY=40
USAGE_CAP_REDACTION_PER_DAY=30
USAGE_CAP_ARTIFACT_PER_DAY=15

# Global kill-switch — set to "true" to make every AI endpoint 503.
AI_DISABLED=false

# Resend (outbound email on handoff transfer). Optional — if unset, the
# transfer flow logs the email payload and continues without sending.
RESEND_API_KEY=
EMAIL_FROM=ContextBridge <noreply@example.com>

CONTEXTHANDOFF_PORT=3071
PUBLIC_HOSTNAME=localhost
TRAEFIK_NETWORK=coolify
PUBLIC_URL=http://localhost:3000
